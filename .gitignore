# Your private half is its own repository, created by ./setup.
home/

# What the agent learns about you and remembers day to day. Keep it out of a fork you share.
USER.md
MEMORY.md
DREAMS.md
memory/

# This install's Discord ids, written by ./setup.
etc/channels.local.json

# Runtime state: the queue store, logs, scratch.
var/
temp/
.DS_Store

# Data files almost always contain real people, whatever folder they sit in.
*.csv

# Skills keep personal detail on disk: answers given once, addresses, drafts to named
# people. The rules cover whole directories, so a new file in one of them cannot slip
# through. Only files named *.example.* are shared.
skills/*/state/
skills/*/config/**
!skills/*/config/**/
!skills/*/config/**/*.example.*

# Python bytecode
__pycache__/
*.pyc

# Skills the Claude app syncs into ~/.claude/skills, when that is a link to skills/
skills/synced/
