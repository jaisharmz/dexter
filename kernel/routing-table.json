{
  "_comment": "Editable routing table for the dispatch skill. Jai messages #dexter and Dexter files the work in the right channel. This is a file he can read and correct, not a prompt-time judgment \u2014 corrections persist. Match on signals, not keywords alone; the hints just weight the decision.",
  "default": "dexter",
  "routes": [
    {
      "channel": "recruiting",
      "hints": [
        "apply",
        "application",
        "job",
        "new grad",
        "internship",
        "resume",
        "essay",
        "interview"
      ]
    },
    {
      "channel": "outreach",
      "hints": [
        "email",
        "cold",
        "reach out",
        "intro",
        "warm intro",
        "draft to",
        "contact them"
      ]
    },
    {
      "channel": "sourcing",
      "hints": [
        "saas",
        "clients",
        "prospects",
        "leads",
        "companies to sell",
        "icp"
      ]
    },
    {
      "channel": "people",
      "hints": [
        "who is",
        "vc",
        "investor",
        "superconnector",
        "worth knowing",
        "add to contacts"
      ]
    },
    {
