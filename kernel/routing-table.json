  "bigFeatureGoesToQueue": true,
  "skillDisambiguation": {
    "_comment": "Two families look alike and are not. Getting this wrong sends a whole research run down the wrong pipeline, which happened on 2026-08-31.",
    "jobSeeking": {
      "skills": [
        "role-sourcing",
        "role-outreach"
      ],
      "use_when": "Jai wants a job, internship, or new-grad role. 'companies I'd want on my resume', 'where should I apply', 'reach out about a role'. role-sourcing qualifies targets; role-outreach writes the approach."
    },
    "clientSeeking": {
      "skills": [
        "outbound-sourcing"
      ],
      "use_when": "Jai is selling something \u2014 finding clients, SaaS prospects, research collaborators. NOT for job applications."
    }
  }
}
